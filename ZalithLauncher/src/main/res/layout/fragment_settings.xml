<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.movtery.zalithlauncher.ui.fragment.SettingsFragment">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/settings_viewpager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_layout" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_layout"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/background_xui_card"
        android:elevation="0dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/shadowView"
            android:visibility="gone"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="0dp"
            android:background="@drawable/shadow_gradient_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/settings_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toStartOf="@+id/shadowView"
            app:layout_constraintStart_toStartOf="parent"
            app:tab_draw_indicator="false"
            app:tab_indicator_enable_flow="false"
            app:tab_orientation="HORIZONTAL"
            app:tab_item_is_equ_width="false"
            app:tab_item_auto_equ_width="false">

                        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:layout_width="0dp"
                app:layout_tab_weight="0.2"
                android:layout_height="64dp"
                android:layout_marginHorizontal="4dp"
                android:padding="4dp"
                android:background="@drawable/xui_tab_chip">
                <ImageView
                    android:id="@+id/video_image"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/setting_category_video"
                    android:scaleType="fitCenter"
                    android:scaleX="0.92"
                    android:scaleY="0.92"
                    app:srcCompat="@drawable/ic_setting_video" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/video_image"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:paddingHorizontal="1dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:text="@string/setting_category_video"
                    android:textColor="@color/xui_text_primary"
                    android:textStyle="bold" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:layout_width="0dp"
                app:layout_tab_weight="0.2"
                android:layout_height="68dp"
                android:layout_marginHorizontal="1dp"
                android:padding="2dp"
                android:background="@drawable/xui_tab_outline">
                <ImageView
                    android:id="@+id/controls_image"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/setting_category_control"
                    android:scaleType="fitCenter"
                    android:scaleX="0.92"
                    android:scaleY="0.92"
                    app:srcCompat="@drawable/ic_menu_custom_controls" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/controls_image"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:paddingHorizontal="1dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:text="@string/setting_category_control"
                    android:textColor="@color/xui_text_primary"
                    android:textStyle="bold" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:layout_width="0dp"
                app:layout_tab_weight="0.2"
                android:layout_height="68dp"
                android:layout_marginHorizontal="1dp"
                android:padding="2dp"
                android:background="@drawable/xui_tab_outline">
                <ImageView
                    android:id="@+id/game_image"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/setting_category_game"
                    android:scaleType="fitCenter"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    app:srcCompat="@drawable/ic_setting_game" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/game_image"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:paddingHorizontal="1dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:text="@string/setting_category_game"
                    android:textColor="@color/xui_text_primary"
                    android:textStyle="bold" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:layout_width="0dp"
                app:layout_tab_weight="0.2"
                android:layout_height="68dp"
                android:layout_marginHorizontal="1dp"
                android:padding="2dp"
                android:background="@drawable/xui_tab_outline">
                <ImageView
                    android:id="@+id/launcher_image"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/setting_category_launcher"
                    android:scaleType="fitCenter"
                    android:scaleX="0.92"
                    android:scaleY="0.92"
                    app:srcCompat="@drawable/ic_setting_launcher" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/launcher_image"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:paddingHorizontal="1dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:text="@string/setting_category_launcher"
                    android:textColor="@color/xui_text_primary"
                    android:textStyle="bold" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:layout_width="0dp"
                app:layout_tab_weight="0.2"
                android:layout_height="68dp"
                android:layout_marginHorizontal="1dp"
                android:padding="2dp"
                android:background="@drawable/xui_tab_outline">
                <ImageView
                    android:id="@+id/experimental_image"
                    android:layout_width="20dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="3dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/setting_category_experimental"
                    android:scaleType="fitCenter"
                    android:scaleX="0.92"
                    android:scaleY="0.92"
                    app:srcCompat="@drawable/ic_setting_experimental" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/experimental_image"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:paddingHorizontal="1dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:text="@string/setting_category_experimental"
                    android:textColor="@color/xui_text_primary"
                    android:textStyle="bold" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

        </com.angcyo.tablayout.DslTabLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>