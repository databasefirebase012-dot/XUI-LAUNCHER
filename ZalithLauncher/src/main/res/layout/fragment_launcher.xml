<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xui_bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:id="@+id/xui_hero_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xui_bg_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">
            <TextView
                android:id="@+id/xui_hero_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XUI  /  GAME CENTER"
                android:textColor="#FFFF405A"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/xui_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="PLAY WITHOUT LIMITS"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:letterSpacing="0.015"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/xui_hero_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Your worlds. Your controls. Your performance."
                android:textColor="#FFB8B8C2"
                android:textSize="12sp" />
            <View
                android:layout_width="72dp"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="#FFFF334F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/play_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/xui_bg_card"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/play_main_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/view_account"
                    layout="@layout/view_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    app:layout_constraintBottom_toTopOf="@id/play_buttons_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/play_buttons_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view_account">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                            android:id="@+id/version"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:background="@drawable/xui_button_outline"
                            android:minHeight="48dp"
                            android:padding="12dp"
                            app:ripple_for_relative="true">
                            <ImageView
                                android:id="@+id/version_icon"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_minecraft" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:layout_toEndOf="@id/version_icon"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/version_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="marquee"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/xui_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/version_info"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="marquee"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:marqueeRepeatLimit="marquee_forever"
                                    android:scrollHorizontally="true"
                                    android:singleLine="true"
                                    android:textColor="@color/xui_text_secondary"
                                    android:textSize="11sp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                        <ImageButton
                            android:id="@+id/manager_profile_button"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:background="@drawable/xui_button_outline"
                            android:contentDescription="@string/version_manager_title"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_setting"
                            app:tint="@color/xui_text_primary" />
                    </LinearLayout>

                    <com.movtery.zalithlauncher.ui.view.AnimButton
                        android:id="@+id/play_button"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/xui_button_primary"
                        android:text="@string/main_launch"
                        android:textAllCaps="true"
                        android:textColor="@color/xui_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/launcher_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:orientation="vertical"
            android:background="@drawable/xui_bg_card"
            android:padding="@dimen/_8sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/about_button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/xui_button_outline"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    app:ripple_for_relative="true">

                    <ImageView
                        android:id="@+id/about_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_about" />
                    <TextView
                        android:id="@+id/about_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/about_icon"
                        android:textColor="@color/xui_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/custom_control_button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/xui_button_outline"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    app:ripple_for_relative="true">
                    <ImageView
                        android:id="@+id/custom_control_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_menu_custom_controls" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/custom_control_icon"
                        android:text="@string/custom_control_title"
                        android:textColor="@color/xui_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/open_main_dir_button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/xui_button_outline"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    app:ripple_for_relative="true">
                    <ImageView
                        android:id="@+id/open_main_dir_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_folder" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/open_main_dir_icon"
                        android:text="@string/main_open_main_dir"
                        android:textColor="@color/xui_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

                <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                    android:id="@+id/install_jar_button"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/xui_button_outline"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    app:ripple_for_relative="true">
                    <ImageView
                        android:id="@+id/install_jar_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_java" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/install_jar_icon"
                        android:text="@string/main_install_jar_file"
                        android:textColor="@color/xui_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
            </LinearLayout>

            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/share_logs_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:background="@drawable/xui_button_outline"
                android:minHeight="48dp"
                android:padding="10dp"
                app:ripple_for_relative="true">
                <ImageView
                    android:id="@+id/share_logs_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_share" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/share_logs_icon"
                    android:text="@string/main_share_logs"
                    android:textColor="@color/xui_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>