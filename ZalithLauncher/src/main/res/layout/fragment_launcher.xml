<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="10dp"
    tools:ignore="ContentDescription">

    <LinearLayout
        android:id="@+id/xui_hero_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/xui_hero_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XUI LAUNCHER"
            android:textColor="#FFFF405A"
            android:textSize="11sp"
            android:letterSpacing="0.10"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xui_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="13:47"
            android:textColor="#FFFFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/xui_hero_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Thursday, Oct 15 2026"
            android:textColor="#FFFF405A"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="#66FFFFFF" />

        <TextView
            android:id="@+id/xui_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/xui_button_skin"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="offline"
            android:textColor="#FFFF405A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/xui_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ping status"
            android:textColor="#FFD0C8C8"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/play_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/xui_bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintHeight_percent="0.17"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/xui_hero_panel">

        <include
            android:id="@+id/view_account"
            layout="@layout/view_account"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <View
            android:layout_width="2dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="#66EF4444" />

        <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
            android:id="@+id/version"
            android:layout_width="42dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/xui_button_skin"
            android:padding="3dp"
            app:ripple_for_relative="true">
            <ImageView
                android:id="@+id/version_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_minecraft" />
            <TextView
                android:id="@+id/version_name"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/version_info"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

        <ImageButton
            android:id="@+id/manager_profile_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/xui_button_skin"
            android:contentDescription="@string/version_manager_title"
            android:src="@drawable/ic_setting"
            app:tint="@color/xui_text_primary" />

        <com.movtery.zalithlauncher.ui.view.AnimButton
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1.2"
            android:background="@drawable/xui_button_primary"
            android:text="@string/main_launch"
            android:textAllCaps="true"
            android:textColor="@color/xui_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/launcher_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/xui_bg_glass"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/play_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/custom_control_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_skin"
                android:padding="10dp"
                app:ripple_for_relative="true">
                <ImageView
                    android:id="@+id/custom_control_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu_custom_controls"
                    app:tint="@color/xui_primary_light" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="normal"
                    android:gravity="center_vertical"
                    android:text="@string/custom_control_title"
                    android:textColor="@color/xui_text_primary"
                    android:textSize="12sp" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/open_main_dir_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_skin"
                android:padding="10dp"
                app:ripple_for_relative="true">
                <ImageView
                    android:id="@+id/open_main_dir_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_folder"
                    app:tint="@color/xui_primary_light" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="normal"
                    android:gravity="center_vertical"
                    android:text="@string/main_open_main_dir"
                    android:textColor="@color/xui_text_primary"
                    android:textSize="12sp" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/install_jar_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_skin"
                android:padding="10dp"
                app:ripple_for_relative="true">
                <ImageView
                    android:id="@+id/install_jar_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_java"
                    app:tint="@color/xui_primary_light" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="normal"
                    android:gravity="center_vertical"
                    android:text="@string/main_install_jar_file"
                    android:textColor="@color/xui_text_primary"
                    android:textSize="12sp" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/share_logs_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_skin"
                android:padding="10dp"
                app:ripple_for_relative="true">
                <ImageView
                    android:id="@+id/share_logs_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_share"
                    app:tint="@color/xui_primary_light" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="normal"
                    android:gravity="center_vertical"
                    android:text="@string/main_share_logs"
                    android:textColor="@color/xui_text_primary"
                    android:textSize="12sp" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/about_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_skin"
                android:padding="10dp"
                app:ripple_for_relative="true">
                <ImageView
                    android:id="@+id/about_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_about"
                    app:tint="@color/xui_primary_light" />
                <TextView
                    android:id="@+id/about_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="normal"
                    android:gravity="center_vertical"
                    android:textColor="@color/xui_text_primary"
                    android:textSize="12sp" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>
            <Button
                android:id="@+id/skin_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_skin"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Skin"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/music_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/xui_button_music"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="Music"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>